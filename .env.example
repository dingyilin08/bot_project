# Copy these values to /etc/qq-rpg/qq-rpg.env on the server.
# Do not commit the real values.
QQ_APP_ID=
QQ_BOT_SECRET=
ADMIN_PASSWORD=
# Production default: /opt/qq-rpg/shared/logs/gm_state.yaml
# Set an absolute writable path if the deployment layout differs.
GM_STATE_FILE=/opt/qq-rpg/shared/logs/gm_state.yaml

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bot_project
MYSQL_PASSWORD=
MYSQL_DATABASE=bot_project

BOT_DOMAIN=https://example.com
QQ_SANDBOX_MODE=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Web 绑定码与会话摘要密钥；生产环境至少 32 个随机字符，不能与 QQ/数据库密码复用。
WEB_AUTH_SECRET=
# 玩家网页入口默认关闭；完成备案与移动端验收后改为 true 并重启服务。
WEB_PLAYER_PORTAL_ENABLED=false
# 反向代理公开源（协议+域名），用于写请求 Origin 校验，例如 https://example.com。
WEB_PUBLIC_ORIGIN=https://example.com
# 生产必须为 true；仅本机 HTTP 调试时设为 false。
WEB_COOKIE_SECURE=true
# 可选：战力图片运行时缓存目录；默认使用系统临时目录，机器人可直接写入。
POWER_CARD_CACHE_DIR=/tmp/qq-rpg-power-cards
# 玩家上传立绘必须放在版本目录之外，避免发布切换时丢失。
POWER_PORTRAIT_DIR=/opt/qq-rpg/shared/power_portraits
